    {
      "id": "block-adamw-contrast-table",
      "kind": "table",
      "level": "analyzing",
      "locator": "§2, Propositions 2–3",
      "title": "Adam with an L2 penalty versus AdamW",
      "columns": [
        "Question",
        "Adam + L2 penalty",
        "AdamW"
      ],
      "rows": [
        [
          "Where is regularization introduced?",
          "Add λθ to the loss gradient",
          "Apply decay directly in the parameter update"
        ],
        [
          "What does Adam adapt?",
          "Loss gradient and penalty together",
          "Loss gradient only"
        ],
        [
          "Is shrinkage coordinate-independent?",
          "No; gradient history changes the effective penalty",
          "Yes for parameters sharing the same decay coefficient"
        ],
        [
          "Why does this matter?",
          "Optimization geometry and regularization become entangled",
          "The two mechanisms are easier to reason about separately"
        ],
        [
          "What remains coupled in practice?",
          "Learning rate, penalty, schedule, and training budget",
          "Effective decay still depends on schedule and number of updates"
        ]
      ],
