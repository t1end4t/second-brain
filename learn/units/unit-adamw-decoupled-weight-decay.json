          "label": "Loss-gradient path",
          "detail": "Gradient enters Adam’s moment estimates"
        },
        {
          "id": "adamw-tree-moment",
          "parentId": "adamw-tree-loss",
          "label": "Adaptive step",
          "detail": "First moment divided by root second moment"
        },
        {
          "id": "adamw-tree-decay",
          "parentId": "adamw-tree-root",
          "label": "Weight-decay path",
          "detail": "Current parameter is shrunk directly"
        },
        {
          "id": "adamw-tree-combine",
          "parentId": "adamw-tree-root",
