    "trigger": "cron [0 0 * * SUN]",
    "action": "Execute run: prompt-eval-matrix",
    "target": "remote-gpu-node-01",
    "enabled": false,
    "lastRun": "4 days ago"
  },
  {
    "id": "auto-orphan-lock-clean",
    "name": "Watchdog: Reclaim Stale Resource Locks",
    "trigger": "interval [every 5m]",
